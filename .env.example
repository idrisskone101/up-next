# TMDB (Required for trailer feature)
# Get your token from: https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_bearer_token_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Server
PORT=5001

# ===== SEARCH WEIGHT CONFIGURATION =====

# Weight Mode: Use dynamic LLM-based weight analysis or fixed weights?
# - false (default): Use fixed weights (faster, cheaper, consistent results)
# - true: Use GPT-4o-mini to analyze each query and determine optimal weights
USE_DYNAMIC_WEIGHTS=false

# Fixed Weight Configuration (only used when USE_DYNAMIC_WEIGHTS=false)
# These three weights MUST sum to exactly 1.0
# Adjust these values to tune search relevance for your use case

# FIXED_WEIGHT_CONTENT: Weight for story/plot/narrative embedding (0.0-1.0)
# Higher values prioritize thematic and story-based matches
FIXED_WEIGHT_CONTENT=0.40

# FIXED_WEIGHT_VIBE: Weight for mood/tone/atmosphere embedding (0.0-1.0)
# Higher values prioritize emotional and atmospheric matches
FIXED_WEIGHT_VIBE=0.35

# FIXED_WEIGHT_METADATA: Weight for genre/cast/director embedding (0.0-1.0)
# Higher values prioritize factual and categorical matches
FIXED_WEIGHT_METADATA=0.25

# Note: Server will validate that weights sum to 1.0 on startup
# Example balanced: 0.40, 0.35, 0.25
# Example content-heavy: 0.60, 0.25, 0.15
# Example vibe-heavy: 0.20, 0.60, 0.20
# Example metadata-heavy: 0.20, 0.20, 0.60
