# OpenAI (required) - powers the title suggestions
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna
# none | low | medium | high | xhigh (low = best speed/quality tradeoff)
REASONING_EFFORT=low
# priority (~1.5-2x faster, higher cost) | default
OPENAI_SERVICE_TIER=priority

# TMDB (required) - posters, metadata, providers, trailers, title autocomplete
# Get your API Read Access Token from: https://www.themoviedb.org/settings/api
TMDB_TOKEN=your_tmdb_bearer_token_here

# Server
PORT=5001
SEARCH_CACHE_TTL_MINUTES=30
