import { ArrowUpRight, AlertCircle } from "lucide-react";
import { ShimmeringText } from "./components/ui/ShimmeringText";
import { Button } from "./components/ui/button";
import { Badge } from "./components/ui/badge";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "./components/ui/card";
import { SearchBar } from "./components/SearchBar";
import { LoadingSpinner } from "./components/LoadingSpinner";
import { ResultsGrid } from "./components/ResultsGrid";
import { useSearch } from "./hooks/useSearch";

const quickPrompts = [
  {
    query: "cozy romantic comedies",
    description: "Warm & feel-good nights in",
  },
  {
    query: "dark revenge thriller",
    description: "Moody tension with a slow burn",
  },
  {
    query: "Christopher Nolan films",
    description: "Meticulous, cerebral storytelling",
  },
  {
    query: "time travel paradox story",
    description: "High-concept sci-fi mindbenders",
  },
  {
    query: "heartwarming coming-of-age",
    description: "Bittersweet growing pains & hope",
  },
  {
    query: "mind-bending sci-fi",
    description: "Stylised worlds with existential stakes",
  },
];

function App() {
  const { results, loading, error, searchMetadata, search, reset } =
    useSearch();

  const hasResults = results.length > 0;
  const showIntro = !loading && !hasResults && !error && !searchMetadata;

  return (
    <div className="relative min-h-dvh overflow-x-hidden">
      <div className="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
        <div className="absolute inset-x-0 top-[-28%] mx-auto h-[520px] w-[520px] -translate-y-6 rounded-full bg-primary/12 blur-[220px] md:h-[660px] md:w-[660px]" />
        <div className="absolute bottom-[-18%] left-[-25%] h-[420px] w-[420px] rounded-full bg-accent/12 blur-[200px] md:left-[-15%]" />
        <div className="absolute inset-y-0 right-[-45%] hidden w-[70%] bg-[radial-gradient(circle_at_top_right,_rgba(56,189,248,0.16),_transparent_60%)] blur-3xl lg:block" />
        <div className="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-background/70 via-transparent to-transparent" />
        <div className="absolute inset-0 bg-grid-lg bg-[size:32px_32px] opacity-[0.05]" />
        <div className="absolute inset-x-0 top-1/3 h-1 bg-gradient-to-r from-transparent via-primary/30 to-transparent opacity-70 blur-[2px]" />
      </div>

      <div className="relative flex min-h-dvh flex-col">
        <header className="container w-full space-y-10 pb-12 pt-safe pt-16 md:space-y-12 md:pb-20 md:pt-20">
          <div className="flex flex-col items-center gap-6 text-center sm:gap-7">
            <Badge variant="outline" className="bg-background/70 px-4 py-1.5">
              Semantic Stream
            </Badge>
            <div className="space-y-4">
              <h1 className="text-balance text-4xl font-medium tracking-tight text-foreground sm:text-5xl md:text-6xl">
                up
                <ShimmeringText
                  text="Next"
                  className="mx-2 inline-block bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent"
                  shimmeringColor="rgba(6, 182, 212, 0.95)"
                  color="rgba(14, 165, 233, 0.85)"
                  duration={1.6}
                />
                elevates movie discovery
              </h1>
              <p className="mx-auto max-w-xl text-pretty text-sm leading-relaxed text-muted-foreground sm:text-base">
                Ask in plain language and let multi-embedding AI surface films
                by tone, themes, pacing, and more. Built mobile-first so the
                next watch is only a thumb-tap away.
              </p>
            </div>
          </div>

          <SearchBar onSearch={search} loading={loading} />

          <div className="mx-auto grid w-full max-w-3xl grid-cols-1 gap-2 sm:grid-cols-2 sm:gap-3">
            {quickPrompts.map(({ query, description }) => (
              <Button
                key={query}
                type="button"
                variant="subtle"
                className="h-auto justify-start rounded-2xl border border-border/30 bg-secondary/70 px-4 py-4 text-left shadow-soft transition-all hover:-translate-y-0.5 hover:bg-secondary/60 sm:rounded-3xl"
                onClick={() => search(query)}
              >
                <div className="flex w-full items-start gap-3">
                  <div className="flex-1 space-y-1">
                    <p className="text-sm font-semibold text-foreground sm:text-base">
                      {query}
                    </p>
                    <p className="text-xs text-muted-foreground sm:text-sm">
                      {description}
                    </p>
                  </div>
                  <ArrowUpRight className="mt-1 h-4 w-4 shrink-0 text-muted-foreground" />
                </div>
              </Button>
            ))}
          </div>
        </header>

        <main className="container flex w-full flex-1 flex-col gap-10 pb-16 pt-4 md:gap-12 md:pb-20">
          {loading && (
            <LoadingSpinner
              message={
                searchMetadata?.weights
                  ? `Dialling up ${
                      Object.entries(searchMetadata.weights).sort(
                        (a, b) => b[1] - a[1],
                      )[0][0]
                    } signals…`
                  : "Parsing vibes and metadata…"
              }
            />
          )}

          {error && !loading && (
            <Card className="mx-auto flex w-full max-w-2xl animate-scale-in flex-col items-center text-center border-destructive/40 bg-destructive/15">
              <CardHeader className="items-center gap-4">
                <div className="flex h-14 w-14 items-center justify-center rounded-full bg-destructive/30">
                  <AlertCircle className="h-6 w-6 text-destructive-foreground" />
                </div>
                <CardTitle className="text-xl">We lost the signal</CardTitle>
                <CardDescription className="text-sm text-muted-foreground">
                  {error}
                </CardDescription>
              </CardHeader>
              <CardContent className="flex w-full items-center justify-center">
                <Button onClick={reset} size="lg" variant="accent">
                  Try again
                </Button>
              </CardContent>
            </Card>
          )}

          {!loading && searchMetadata && results.length === 0 && !error && (
            <Card className="mx-auto w-full max-w-3xl animate-scale-in text-center">
              <CardHeader className="items-center gap-3">
                <CardTitle className="text-2xl">
                  Nothing matched just yet
                </CardTitle>
                <CardDescription>
                  Tune your prompt with vibe descriptors, era, or pacing details
                  to help the model triangulate the right titles.
                </CardDescription>
              </CardHeader>
              <CardContent>
                <div className="flex flex-wrap justify-center gap-2 text-sm text-muted-foreground">
                  {["slow burn mystery", "female-led heist", "post-apocalyptic hope"].map(
                    (item) => (
                      <span
                        key={item}
                        className="rounded-full border border-border/50 px-3 py-1.5 text-xs uppercase tracking-wide"
                      >
                        {item}
                      </span>
                    ),
                  )}
                </div>
              </CardContent>
            </Card>
          )}

          {hasResults && !loading && (
            <ResultsGrid results={results} searchMetadata={searchMetadata} />
          )}

          {showIntro && (
            <Card className="mx-auto w-full max-w-4xl animate-scale-in border border-border/40 bg-card/70 px-1.5 pb-6 pt-1.5 shadow-soft backdrop-blur-xl sm:px-3">
              <CardHeader className="items-center gap-3 text-center">
                <CardTitle className="text-2xl">
                  Try a cinematic moodboard
                </CardTitle>
                <CardDescription>
                  Layer in vibes, pacing, or creative references to get
                  hyper-relevant picks. The model blends content, metadata, and
                  emotional resonance for you.
                </CardDescription>
              </CardHeader>
              <CardContent className="grid grid-cols-1 gap-3 sm:grid-cols-2">
                {quickPrompts.map(({ query, description }) => (
                  <Button
                    key={`intro-${query}`}
                    type="button"
                    variant="outline"
                    className="h-auto justify-start rounded-2xl border-border/40 bg-background/60 px-4 py-4 text-left transition hover:bg-background/70 sm:rounded-3xl"
                    onClick={() => search(query)}
                  >
                    <div className="flex flex-col gap-2">
                      <span className="text-sm font-semibold text-foreground sm:text-base">
                        {query}
                      </span>
                      <span className="text-xs text-muted-foreground sm:text-sm">
                        {description}
                      </span>
                    </div>
                  </Button>
                ))}
              </CardContent>
            </Card>
          )}
        </main>

        <footer className="pb-safe pb-12 pt-8">
          <div className="container flex flex-col items-center gap-3 text-center text-xs text-muted-foreground/80 sm:text-sm">
            <p>
              Powered by multi-embedding semantic search with adaptive signal
              weighting.
            </p>
            <p>© {new Date().getFullYear()} upNext. Curated with curiosity.</p>
          </div>
        </footer>
      </div>
    </div>
  );
}

export default App;
