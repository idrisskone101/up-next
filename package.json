{
  "name": "upnext-movie-search",
  "version": "1.0.0",
  "description": "Semantic movie/TV search with multi-embedding vectors and LLM-powered weight adjustment",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:api": "node test-api.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.548.0",
    "openai": "^4.77.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
